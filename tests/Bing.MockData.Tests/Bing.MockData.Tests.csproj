<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <MockDataTargetFramework Condition="'$(MockDataTargetFramework)' == ''">net10.0</MockDataTargetFramework>
    <DefineConstants Condition="'$(MockDataTargetFramework)' == 'netstandard2.0'">$(DefineConstants);MOCKDATA_NETSTANDARD</DefineConstants>
    <OutputPath>bin/$(Configuration)/$(MockDataTargetFramework)/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(MockDataTargetFramework)/</IntermediateOutputPath>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bing.MockData\Bing.MockData.csproj" SetTargetFramework="TargetFramework=$(MockDataTargetFramework)" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
